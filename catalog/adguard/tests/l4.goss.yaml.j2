# L4 app checks for AdGuard Home on {{ inventory_hostname }} (was homelab-infra tests/apps/dns.goss.yaml.j2).
# Read-only: nothing here changes the guest. No credentials (the AdGuard admin API is not used). Loopback, plus the
# partner resolver for the peer check.
# Role defaults are not necessarily loaded when this renders, so every value has the same literal as fallback (keep in
# sync with role/defaults/main.yml). The enabled filters are read from the LIVE config on the guest, not from vars.
# Listeners are checked with ss, not Goss port: AdGuard (Go) on 0.0.0.0 opens dual-stack [::] sockets that Goss
# tcp:/udp: (IPv4 table only) would miss.
{% set adguard_dir = app_adguard_dir | default('/opt/AdGuardHome') %}
{% set adguard_conf = app_adguard_conf_dir | default(adguard_dir ~ '/conf') %}
{% set adguard_drift = app_adguard_drift_script | default('/usr/local/sbin/hm1-adguard-drift') %}
{% set dns_port = app_adguard_dns_port | default(53) %}
{% set http_port = app_adguard_http_port | default(80) %}
{% set probe_domain = app_adguard_probe_domain | default('probe.hm1.lox-internal.dev') %}
{% set probe_answer = app_adguard_probe_answer | default('192.0.2.53') %}
service:
  AdGuardHome:
    enabled: true
    running: true
command:
  app-dns-listen-tcp53:
    exec: 'n=$(ss -Hltnp "sport = :{{ dns_port }}" | grep -c AdGuardHome); echo "AdGuardHome tcp/{{ dns_port }} listeners: $n"; test "$n" -gt 0'
    exit-status: 0
  app-dns-listen-udp53:
    exec: 'n=$(ss -Hlunp "sport = :{{ dns_port }}" | grep -c AdGuardHome); echo "AdGuardHome udp/{{ dns_port }} listeners: $n"; test "$n" -gt 0'
    exit-status: 0
  app-dns-listen-webui:
    exec: 'n=$(ss -Hltnp "sport = :{{ http_port }}" | grep -c AdGuardHome); echo "AdGuardHome tcp/{{ http_port }} listeners: $n"; test "$n" -gt 0'
    exit-status: 0
  app-dns-webui-http:
    exec: 'c=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 http://127.0.0.1:{{ http_port }}/); echo "web UI HTTP $c"; case "$c" in 200|302) exit 0;; *) exit 1;; esac'
    exit-status: 0
  app-dns-query:
    exec: 'a=$(dig +short +time=3 +tries=2 @127.0.0.1 -p {{ dns_port }} example.com A); rc=$?; echo "dig rc=$rc answer: $(echo $a | head -c 120)"; test $rc -eq 0 && echo "$a" | grep -Eq "^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$"'
    exit-status: 0
    timeout: 20000
  app-dns-probe-rewrite:
    exec: 'a=$(dig +short +time=3 +tries=2 @127.0.0.1 -p {{ dns_port }} {{ probe_domain }} A); echo "{{ probe_domain }} -> $a"; test "$a" = "{{ probe_answer }}"'
    exit-status: 0
    timeout: 20000
{% for h in groups['role_dns'] | default([]) | sort %}
{% if h != inventory_hostname %}
  app-dns-peer-{{ h }}:
    exec: 'a=$(dig +short +time=3 +tries=2 @{{ hostvars[h].ansible_host | default(h) }} -p {{ dns_port }} {{ probe_domain }} A); echo "peer {{ h }}: {{ probe_domain }} -> $a"; test "$a" = "{{ probe_answer }}"'
    exit-status: 0
    timeout: 20000
{% endif %}
{% endfor %}
  app-dns-filter-rules:
    exec: |
      python3 -c '
      import re, sys, yaml
      live = yaml.safe_load(open(sys.argv[1]))
      bad = 0
      seen = 0
      for f in live.get("filters") or []:
          if not f.get("enabled"):
              continue
          seen += 1
          try:
              n = sum(1 for l in open("%s/data/filters/%d.txt" % (sys.argv[2], f["id"])) if not re.match(r"\s*($|!|#|\[)", l))
          except OSError:
              n = 0
          print("filter %d: %d rules" % (f["id"], n))
          bad += n == 0
      print("enabled filters: %d, with 0 rules: %d" % (seen, bad))
      sys.exit(1 if bad or not seen else 0)
      ' {{ adguard_conf }}/AdGuardHome.yaml {{ adguard_dir }}
    exit-status: 0
    timeout: 20000
  app-dns-config-drift:
    exec: 'out=$({{ adguard_drift }} {{ adguard_conf }}/AdGuardHome.yaml.managed {{ adguard_conf }}/AdGuardHome.yaml); rc=$?; echo "drift rc=$rc (0 in sync, 1 drift, 2 cannot compare) $(echo $out | head -c 200)"; test $rc -eq 0'
    exit-status: 0
